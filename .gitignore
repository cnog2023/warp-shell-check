# Other people's work: kept locally, linked from INDEX.md, never redistributed from here
sources/**
!sources/papers/
!sources/papers/MANIFEST.tsv
repos/

# Environments and caches
.venv*/
__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/

# Large intermediate results (keep small npz/csv that a figure needs)
work/**/*.mat
work/**/*.h5

# CI output written on the runner
results/

# Large regenerable data: profiles are rebuilt by replicate_profiles.py or re-downloaded with gh run download
work/shell/ci-artifacts/profiles_*.csv
work/shell/replica/*.csv

# Local clone of the GitHub wiki (its own git repository)
wiki/
